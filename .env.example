# WWP Launch Radar configuration. Copy to .env (setup.bat does this) and adjust.
# Real environment variables override values in this file.

# --- Monitored game ----------------------------------------------------------------
WWP_APP_ID=3222640
WWP_GAME_NAME=Wild West Pioneers
# Launch date AND time, e.g. 2026-10-15 18:00 (read in WWP_DISPLAY_TZ) or 2026-10-15T18:00:00+02:00.
# A time alone (e.g. 14:00) is not enough. Leave empty until known; it can also be set in the dashboard.
WWP_LAUNCH_AT=
WWP_DISPLAY_TZ=Europe/Warsaw

# --- Polling (seconds) ---------------------------------------------------------------
WWP_CCU_INTERVAL=60
WWP_REVIEW_INTERVAL=120

# --- Server ---------------------------------------------------------------------------
# Localhost only by default. Binding to anything else requires WWP_DASHBOARD_PASSWORD
# (or WWP_TRUST_PROXY_AUTH=true behind an authenticating reverse proxy).
WWP_HOST=127.0.0.1
WWP_PORT=8765
WWP_DASHBOARD_PASSWORD=
# Optional; generated and stored in the data directory when empty.
WWP_SESSION_SECRET=
WWP_TRUST_PROXY_AUTH=false

# Data directory. Default on Windows: %LOCALAPPDATA%\WWPLaunchRadar ; in Docker: /data
# WWP_DATA_DIR=

# --- Steam HTTP -------------------------------------------------------------------------
WWP_HTTP_TIMEOUT=20
WWP_HTTP_MAX_RETRIES=4
WWP_STEAM_MAX_CONCURRENCY=2
WWP_STEAM_MIN_REQUEST_GAP=1.0

# --- Optional AI review analysis (Anthropic Claude) -------------------------------------
# The application is fully functional without this.
WWP_AI_ENABLED=false
ANTHROPIC_API_KEY=
WWP_AI_MODEL=claude-opus-5
WWP_AI_INTERVAL=600
WWP_AI_BATCH_SIZE=120

WWP_LOG_LEVEL=INFO
